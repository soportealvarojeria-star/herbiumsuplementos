---
// src/components/Cart.astro
---

<!-- Para esta prueba, lo dejaremos visible en la pantalla (luego lo ocultaremos para que se abra solo al hacer clic) -->
<div id="cart-drawer" class="fixed inset-y-0 right-0 w-full md:w-96 bg-white shadow-2xl z-50 flex flex-col border-l border-gray-200">
  
  <!-- Cabecera del Carrito -->
  <div class="px-6 py-5 border-b border-gray-100 flex justify-between items-center bg-[#F4F1EA]">
    <h2 class="text-xl font-light text-[#2C302E]">Tu Carrito</h2>
    <button id="close-cart" class="text-gray-400 hover:text-gray-800 transition-colors">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Lista de Productos (Producto de prueba temporal) -->
  <div class="flex-1 overflow-y-auto p-6">
    <div class="flex items-center gap-4 mb-6">
      <div class="w-20 h-20 bg-gray-100 rounded-sm overflow-hidden">
         <img src="https://images.pexels.com/photos/3850774/pexels-photo-3850774.jpeg?auto=compress&cs=tinysrgb&w=200" alt="Suplemento" class="w-full h-full object-cover" />
      </div>
      <div class="flex-1">
        <h3 class="text-sm font-medium text-gray-800">Cápsulas de Ashwagandha</h3>
        <p class="text-[11px] uppercase tracking-wider text-gray-500 mt-1">Balance y Calma</p>
        <div class="mt-2 flex justify-between items-center">
          <span class="text-sm font-bold text-[#1A3A2F]">$24.990</span>
          <span class="text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded">Cant: 1</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Pie del Carrito y Botón de Pago -->
  <div class="p-6 border-t border-gray-100 bg-white">
    <div class="flex justify-between mb-6">
      <span class="text-sm font-medium text-gray-500 uppercase tracking-wider">Total a pagar</span>
      <span class="text-xl font-bold text-[#1A3A2F]">$24.990</span>
    </div>
    
    <button 
      id="btn-pagar" 
      class="w-full bg-[#1A3A2F] text-white text-sm tracking-widest uppercase py-4 hover:bg-[#11261f] transition-all duration-300 shadow-lg hover:shadow-xl flex justify-center items-center gap-2"
    >
      <span>Ir al pago seguro</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    </button>
    <p class="text-center text-[10px] text-gray-400 mt-3 flex items-center justify-center gap-1">
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
      Pago procesado por Mercado Pago
    </p>
  </div>
</div>

<script>
  // Esta es la lógica que conecta el botón con el archivo pagar.js que creaste antes
  const btnPagar = document.getElementById('btn-pagar');
  
  if(btnPagar) {
    btnPagar.addEventListener('click', async () => {
      // 1. Cambiamos el botón para que el usuario sepa que está cargando
      btnPagar.innerHTML = '<span class="animate-pulse">Procesando conexión...</span>';
      btnPagar.disabled = true;
      btnPagar.classList.add('opacity-80', 'cursor-not-allowed');

      try {
        // 2. Preparamos la información de lo que se va a cobrar
        const carritoActual = {
          items: [
            {
              id: "PROD-001",
              title: "Cápsulas de Ashwagandha - Herbium",
              quantity: 1,
              unit_price: 24990 // Precio sin puntos ni comas
            }
          ]
        };

        // 3. Enviamos los datos a tu ruta secreta en el servidor
        const response = await fetch('/api/pagar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(carritoActual)
        });

        const data = await response.json();

        // 4. Si Mercado Pago nos devuelve el link seguro, redirigimos al cliente
        if (data.url) {
          window.location.href = data.url;
        } else {
          alert('Hubo un error al conectar con Mercado Pago.');
          btnPagar.innerHTML = '<span>Ir al pago seguro</span>';
          btnPagar.disabled = false;
        }
      } catch (error) {
        console.error("Error:", error);
        alert('Error de conexión.');
        btnPagar.innerHTML = '<span>Ir al pago seguro</span>';
        btnPagar.disabled = false;
      }
    });
  }
</script>