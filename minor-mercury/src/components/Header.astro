  <nav class="hidden md:flex gap-10 text-xs uppercase tracking-[0.15em] text-[#1A1A1A]/70 font-medium">
    <a href="#catalogo" class="hover:text-[#1E3A2F] transition-colors">Catálogo</a>
    <a href="#" class="hover:text-[#1E3A2F] transition-colors">Propósito</a>
    <a href="#" class="hover:text-[#1E3A2F] transition-colors">Contacto</a>
  </nav>
  <button id="header-cart-btn" class="text-xs font-medium uppercase tracking-[0.15em] bg-[#F9F8F6] px-6 py-2.5 rounded shadow-sm border border-[#1A1A1A]/10 hover:border-[#1E3A2F] hover:bg-white text-[#1E3A2F] transition-all cursor-pointer">
    Carrito (0)
