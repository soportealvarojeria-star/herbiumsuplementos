---
// src/components/Header.astro
---
<header class="w-full px-6 lg:px-12 py-5 flex justify-between items-center border-b border-[#1A1A1A]/10 bg-white sticky top-0 z-40">
  <a href="/" class="text-2xl tracking-[0.15em] text-[#1E3A2F] font-semibold hover:opacity-80 transition-opacity">HERBIUM</a>
  
  <!-- Navegación de Escritorio (Oculta en móviles) -->
  <nav class="hidden md:flex gap-10 text-xs uppercase tracking-[0.15em] text-[#1A1A1A]/70 font-medium">
    <a href="/#catalogo" class="hover:text-[#1E3A2F] transition-colors">Catálogo</a>
    <a href="/proposito" class="hover:text-[#1E3A2F] transition-colors">Propósito</a>
    <a href="/contacto" class="hover:text-[#1E3A2F] transition-colors">Contacto</a>
  </nav>

  <div class="flex items-center gap-4">
    <button id="header-cart-btn" class="text-[10px] md:text-xs font-medium uppercase tracking-[0.15em] bg-[#F9F8F6] px-4 md:px-6 py-2.5 rounded shadow-sm border border-[#1A1A1A]/10 hover:border-[#1E3A2F] hover:bg-white text-[#1E3A2F] transition-all cursor-pointer">
      Carrito (0)
    </button>

    <!-- Botón Menú Hamburguesa (Visible solo en móviles) -->
    <button id="mobile-menu-btn" class="md:hidden text-[#1E3A2F] p-1 cursor-pointer">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </button>
  </div>

  <!-- Menú Desplegable para Móviles -->
  <div id="mobile-menu" class="fixed inset-0 bg-[#F4F1EA] z-50 flex flex-col items-center justify-center gap-10 hidden transition-opacity duration-300">
    <button id="close-menu-btn" class="absolute top-6 right-6 text-[#1A1A1A] p-2 cursor-pointer">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    <a href="/#catalogo" class="mobile-link text-2xl uppercase tracking-widest text-[#1E3A2F] font-medium">Catálogo</a>
    <a href="/proposito" class="mobile-link text-2xl uppercase tracking-widest text-[#1E3A2F] font-medium">Propósito</a>
    <a href="/contacto" class="mobile-link text-2xl uppercase tracking-widest text-[#1E3A2F] font-medium">Contacto</a>
  </div>
</header>

<script>
  // Lógica para abrir y cerrar el menú móvil
  const menuBtn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('close-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const links = document.querySelectorAll('.mobile-link');

  if (menuBtn && closeBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.remove('hidden');
    });
    closeBtn.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
    });
    // Cerrar el menú automáticamente al hacer clic en un enlace
    links.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
      });
    });
  }
</script>