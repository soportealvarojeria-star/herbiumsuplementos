---
// src/components/Hero.astro
---

<section class="relative w-full min-h-[85vh] flex items-center bg-[#F4F1EA] overflow-hidden">
  
  <!-- Contenido de Fondo: 100% compatible -->
  <div class="absolute inset-0 w-full h-full pointer-events-none">
    
    <!-- Imagen Botánica Derecha (Animada sutilmente) -->
    <div class="absolute top-0 right-0 w-full md:w-[65%] h-full">
      <img src="https://images.pexels.com/photos/13105350/pexels-photo-13105350.jpeg?auto=compress&cs=tinysrgb&w=1800" 
        alt="Fondo botánico" 
        class="w-full h-full object-cover object-right animate-breathe opacity-90 md:opacity-100"
      />
    </div>

    <!-- Degradados estándar de fusión (en vez de máscaras complejas) -->
    <!-- Para escritorio (de Izquierda a Derecha) -->
    <div class="hidden md:block absolute inset-0 bg-gradient-to-r from-[#F4F1EA] via-[#F4F1EA] via-40% to-transparent z-10"></div>
    
    <!-- Para móviles (de Abajo hacia Arriba y cobertura suave) -->
    <div class="block md:hidden absolute inset-0 bg-gradient-to-t from-[#F4F1EA] via-[#F4F1EA]/75 to-transparent z-10"></div>
    <div class="block md:hidden absolute inset-0 bg-[#F4F1EA]/40 z-10"></div>

  </div>

  <!-- Contenido de Texto e Interfaz -->
  <div class="relative z-20 w-full max-w-7xl mx-auto px-6 py-16 md:py-0 flex flex-col items-center md:items-start text-center md:text-left">
    
    <!-- Etiqueta superior -->
    <span class="inline-block bg-white/95 backdrop-blur-sm tracking-[0.2em] text-[10px] md:text-xs font-bold text-gray-800 py-3 px-6 md:px-8 shadow-sm mb-6 md:mb-8 uppercase">
      Poder natural purificado
    </span>
    
    <!-- Título Principal (más responsivo) -->
    <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-7xl font-light text-[#2C302E] leading-tight mb-8 max-w-2xl break-words">
      Suplementos botánicos para un <br class="hidden md:block"/> 
      balance <span class="text-[#B97A63] italic font-normal">perfecto.</span>
    </h1>
    
    <!-- Botón -->
    <a 
      href="#catalogo" 
      class="inline-block bg-[#1A3A2F] text-white text-xs md:text-sm tracking-widest uppercase py-4 px-10 md:px-12 hover:bg-[#11261f] transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-0.5"
    >
      Explorar Colección
    </a>

  </div>
</section>

<style>
  @keyframes breathe {
    0% { transform: scale(1); }
    50% { transform: scale(1.03); }
    100% { transform: scale(1); }
  }
  
  .animate-breathe {
    animation: breathe 18s ease-in-out infinite;
  }
</style>