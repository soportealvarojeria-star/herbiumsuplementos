---
import Header from '../components/Header.astro';
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Contacto | Herbium</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['Jost', 'sans-serif'],
            }
          }
        }
      }
    </script>
  </head>
  
  <body class="bg-[#F4F1EA] text-[#1A1A1A] antialiased selection:bg-[#1E3A2F] selection:text-[#F4F1EA] flex flex-col min-h-screen">
    
    <Header />

    <main class="flex-1 w-full max-w-[75rem] mx-auto px-6 py-20 md:py-32">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-start">
        
        <!-- Columna de Información -->
        <div>
          <span class="text-[11px] text-[#C17767] font-medium uppercase tracking-[0.2em] mb-4 block">Hablemos</span>
          <h1 class="text-4xl text-[#1E3A2F] font-medium mb-8 leading-tight">Estamos aquí para resolver tus dudas.</h1>
          <p class="text-[#1A1A1A]/70 font-light leading-relaxed mb-12">
            Ya sea que necesites asesoría sobre qué suplemento elegir, o tengas consultas sobre tu pedido, nuestro equipo está listo para ayudarte.
          </p>

          <div class="space-y-8">
            <div>
              <h3 class="text-[11px] uppercase tracking-[0.2em] font-medium text-[#1A1A1A] mb-2">Correo Electrónico</h3>
              <a href="mailto:contacto@herbium.cl" class="text-lg text-[#1E3A2F] hover:text-[#C17767] transition-colors">contacto@herbium.cl</a>
            </div>
            
            <div>
              <h3 class="text-[11px] uppercase tracking-[0.2em] font-medium text-[#1A1A1A] mb-2">Horario de Atención</h3>
              <p class="text-[#1A1A1A]/70">Lunes a Viernes: 09:00 - 18:00 hrs.</p>
            </div>
          </div>
        </div>

        <!-- Columna del Formulario -->
        <div class="bg-white p-8 md:p-12 rounded-xl border border-[#1A1A1A]/5 shadow-[0_10px_40px_rgba(0,0,0,0.03)]">
          <form class="flex flex-col gap-6" action="#" method="POST">
            <div>
              <label for="nombre" class="block text-[11px] uppercase tracking-[0.1em] font-medium text-[#1A1A1A] mb-2">Nombre Completo</label>
              <input type="text" id="nombre" name="nombre" required class="w-full bg-[#F9F8F6] border border-[#1A1A1A]/10 rounded-sm px-4 py-3 text-sm focus:outline-none focus:border-[#1E3A2F] transition-colors" placeholder="Tu nombre">
            </div>
            
            <div>
              <label for="email" class="block text-[11px] uppercase tracking-[0.1em] font-medium text-[#1A1A1A] mb-2">Correo Electrónico</label>
              <input type="email" id="email" name="email" required class="w-full bg-[#F9F8F6] border border-[#1A1A1A]/10 rounded-sm px-4 py-3 text-sm focus:outline-none focus:border-[#1E3A2F] transition-colors" placeholder="tu@email.com">
            </div>
            
            <div>
              <label for="mensaje" class="block text-[11px] uppercase tracking-[0.1em] font-medium text-[#1A1A1A] mb-2">Tu Mensaje</label>
              <textarea id="mensaje" name="mensaje" rows="4" required class="w-full bg-[#F9F8F6] border border-[#1A1A1A]/10 rounded-sm px-4 py-3 text-sm focus:outline-none focus:border-[#1E3A2F] transition-colors resize-none" placeholder="¿En qué te podemos ayudar?"></textarea>
            </div>
            
            <button type="submit" class="w-full bg-[#1E3A2F] text-white py-4 mt-2 rounded-sm text-xs font-medium uppercase tracking-[0.2em] hover:bg-[#1A1A1A] transition-colors cursor-pointer">
              Enviar Mensaje
            </button>
          </form>
        </div>

      </div>
    </main>

  </body>
</html>